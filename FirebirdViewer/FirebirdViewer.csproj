<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>FirebirdViewer</RootNamespace>
    <AssemblyName>FirebirdViewer</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Assembly metadata -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>FirebirdViewer</Authors>
    <Product>Firebird Database Viewer</Product>
    <Description>WPF tool for browsing Firebird databases.</Description>
    <Copyright>Copyright (c) 2026</Copyright>

    <!-- Localization: Resources/Strings.resx holds Russian, which is also what the
         database stores. Strings.kk.resx / Strings.uz-Latn.resx build into satellite
         assemblies (kk\, uz-Latn\ next to the .exe). -->
    <NeutralLanguage>ru</NeutralLanguage>

    <!-- Build hygiene -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.1" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.55" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
