<Window x:Class="FirebirdViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FirebirdViewer.ViewModels"
        xmlns:m="clr-namespace:FirebirdViewer.Models"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="780" Width="1300"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5"                      Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F5" Modifiers="Control"  Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- ===================== Top menu ===================== -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Подключиться к базе..."  Click="ConnectMenu_Click"/>
                <MenuItem Header="_Отключиться"             Command="{Binding DisconnectCommand}"/>
                <Separator/>
                <MenuItem Header="_Недавние подключения" ItemsSource="{Binding RecentConnections}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Display}"/>
                            <Setter Property="Command" Value="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Очистить список"  Command="{Binding ClearRecentCommand}"/>
                <Separator/>
                <MenuItem Header="_Сохранить таблицу в CSV..."     Command="{Binding ExportDataCommand}"/>
                <MenuItem Header="Сохранить _операции в CSV..."    Command="{Binding ExportOperationsCommand}"/>
                <Separator/>
                <MenuItem Header="В_ыход" Click="ExitMenu_Click"/>
            </MenuItem>

            <MenuItem Header="_Правка">
                <MenuItem Header="_Копировать выделенное" Command="ApplicationCommands.Copy"/>
            </MenuItem>

            <MenuItem Header="_Показать">
                <MenuItem Header="Показать _все колонки"       Command="{Binding ToggleAllColumnsCommand}"/>
                <Separator/>
                <MenuItem Header="Переместить колонку в_верх"  Command="{Binding MoveColumnUpCommand}"/>
                <MenuItem Header="Переместить колонку в_низ"   Command="{Binding MoveColumnDownCommand}"/>
                <Separator/>
                <MenuItem Header="_Обновить данные"  Command="{Binding RefreshCommand}" InputGestureText="F5"/>
            </MenuItem>

            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===================== Status bar (bottom) ===================== -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource StatusBackground}">
            <StatusBarItem>
                <Border Background="#3CB371" Padding="8,2" CornerRadius="2"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding RowCountText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding OperationsCountText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding CursorText}" Foreground="{StaticResource MutedForeground}"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ConnectionInfoText}" Foreground="{StaticResource MutedForeground}" Margin="0,0,8,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===================== Top bar: well + race pickers ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6">
            <DockPanel>
                <!-- Right: row limit + refresh -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Показывать записей:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding RowLimit, UpdateSourceTrigger=LostFocus}" Width="70"
                             ToolTip="Максимальное число строк, загружаемых из базы"/>
                    <Button Content="Обновить" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                            ToolTip="Перечитать данные текущей скважины и рейса (F5)"/>
                </StackPanel>
                <!-- Left: well + race pickers -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Скважина:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="280"
                              ItemsSource="{Binding Wells}"
                              SelectedItem="{Binding SelectedWell, Mode=TwoWay}"
                              IsEnabled="{Binding IsConnected}"
                              ToolTip="Выберите скважину для просмотра">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Рейс:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox Width="260"
                              ItemsSource="{Binding Races}"
                              SelectedItem="{Binding SelectedRace, Mode=TwoWay}"
                              IsEnabled="{Binding IsConnected}"
                              ToolTip="Ограничьте просмотр одним рейсом или выберите «Все рейсы»">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Main: tab control ===================== -->
        <TabControl Margin="6" SelectedIndex="1">

                <!-- ===== Графики ===== -->
                <TabItem Header="Графики">
                    <DockPanel>
                        <!-- Global toolbar: + Добавить график, общая ориентация -->
                        <Border DockPanel.Dock="Top" Padding="6"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Добавить график"
                                        Command="{Binding AddChartCommand}"
                                        Padding="10,3"
                                        ToolTip="Создать ещё одну панель графика"/>

                                <TextBlock Text="Ориентация:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                <RadioButton Content="Горизонтальная"
                                             GroupName="GlobalOrientation" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding GlobalOrientationIsHorizontal, Mode=TwoWay}"
                                             ToolTip="Графики располагаются друг под другом"/>
                                <RadioButton Content="Вертикальная"
                                             GroupName="GlobalOrientation"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding GlobalOrientationIsVertical, Mode=TwoWay}"
                                             ToolTip="Графики располагаются слева направо; новые добавляются справа"/>
                            </StackPanel>
                        </Border>

                        <!-- Charts list. ScrollViewer direction and ItemsPanel orientation
                             flip together based on the global orientation. -->
                        <ScrollViewer>
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GlobalOrientationIsVertical}" Value="True">
                                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <ItemsControl ItemsSource="{Binding Charts}">
                                <!--
                                    Critical: a SINGLE StackPanel instance is reused; only its
                                    Orientation flips via DataTrigger. Swapping the
                                    ItemsPanelTemplate would rebuild every PlotView and produce
                                    "This PlotModel is already in use" because the new view
                                    tries to attach to the stable PlotModel before the old view
                                    has unloaded.
                                -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Orientation" Value="Vertical"/>
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.GlobalOrientationIsVertical}"
                                                            Value="True">
                                                            <Setter Property="Orientation" Value="Horizontal"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                        </StackPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartPanelViewModel}">
                                        <Border BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="0,0,1,1"
                                                Margin="0,0,4,4"
                                                Background="White"
                                                MinWidth="440">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Landscape: panels stack downward, so each needs a
                                                         minimum height and the list scrolls vertically. -->
                                                    <Setter Property="MinHeight" Value="420"/>
                                                    <Style.Triggers>
                                                        <!-- Portrait: panels sit side by side. Stretch to the
                                                             viewport height instead of forcing a fixed 420,
                                                             which pushed the content past the bottom edge. -->
                                                        <DataTrigger
                                                            Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.GlobalOrientationIsVertical}"
                                                            Value="True">
                                                            <Setter Property="MinHeight" Value="0"/>
                                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <!-- Per-chart header: title, X-axis, parameters popup, scale toggle, remove -->
                                                <Border DockPanel.Dock="Top" Padding="6"
                                                        Background="{StaticResource PanelBackground}"
                                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕"
                                                                Width="24" Height="22"
                                                                ToolTip="Удалить этот график"
                                                                Command="{Binding DataContext.RemoveChartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="160" VerticalAlignment="Center"
                                                                     ToolTip="Название графика"/>

                                                            <TextBlock Text="Ось X:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                                            <RadioButton Content="Время" Margin="0,0,8,0"
                                                                         IsChecked="{Binding XAxisIsTime, Mode=TwoWay}"/>
                                                            <RadioButton Content="Глубина забоя"
                                                                         IsChecked="{Binding XAxisIsDepth, Mode=TwoWay}"/>

                                                            <!-- Parameters: popup instead of a permanent left column -->
                                                            <ToggleButton x:Name="ParamsButton"
                                                                          Content="Параметры ▾" Padding="8,3"
                                                                          Margin="16,0,0,0"
                                                                          VerticalAlignment="Center"
                                                                          ToolTip="Выбрать параметры для построения"/>
                                                            <Popup IsOpen="{Binding IsChecked, ElementName=ParamsButton, Mode=TwoWay}"
                                                                   PlacementTarget="{Binding ElementName=ParamsButton}"
                                                                   Placement="Bottom"
                                                                   StaysOpen="False"
                                                                   AllowsTransparency="True">
                                                                <Border Background="White"
                                                                        BorderBrush="{StaticResource PanelBorder}"
                                                                        BorderThickness="1"
                                                                        Padding="4">
                                                                    <ListBox ItemsSource="{Binding Parameters}"
                                                                             MinWidth="260" MaxHeight="440"
                                                                             BorderThickness="0"
                                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                        <ListBox.ItemContainerStyle>
                                                                            <Style TargetType="ListBoxItem">
                                                                                <Setter Property="Padding" Value="2"/>
                                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                                            </Style>
                                                                        </ListBox.ItemContainerStyle>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate DataType="{x:Type vm:ChartParameterRef}">
                                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                          Content="{Binding DisplayName}"
                                                                                          ToolTip="{Binding Description}"/>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                </Border>
                                                            </Popup>

                                                            <CheckBox Content="Своя шкала для каждой кривой"
                                                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                                                      IsChecked="{Binding SeparateScales, Mode=TwoWay}"
                                                                      ToolTip="Каждая кривая получает свою ось значений (для разных диапазонов)"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Band-selection statistics (Shift + drag) -->
                                                <Border DockPanel.Dock="Bottom" Padding="6"
                                                        Background="#FBFCFE"
                                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0"
                                                        Visibility="{Binding HasSelectionStats, Converter={StaticResource BoolToVisibility}}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Очистить"
                                                                Padding="8,2" VerticalAlignment="Top"
                                                                Command="{Binding ClearSelectionCommand}"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SelectionRangeText}"
                                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <ItemsControl ItemsSource="{Binding SelectionStats}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:CurveStat}">
                                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                            <Border Width="12" Height="12" Margin="0,0,6,0"
                                                                                    Background="{Binding Swatch}"/>
                                                                            <TextBlock Text="{Binding Name}" Width="220" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="сред: " Foreground="{StaticResource MutedForeground}"/>
                                                                            <TextBlock Text="{Binding AvgText}" Width="70" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="мин: " Foreground="{StaticResource MutedForeground}"/>
                                                                            <TextBlock Text="{Binding MinText}" Width="70"/>
                                                                            <TextBlock Text="макс: " Foreground="{StaticResource MutedForeground}"/>
                                                                            <TextBlock Text="{Binding MaxText}" Width="70"/>
                                                                            <TextBlock Text="точек: " Foreground="{StaticResource MutedForeground}"/>
                                                                            <TextBlock Text="{Binding Count}"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Clickable legend: click a curve to set its colour / line type / thickness.
                                                     Docked at the top so it stays above the plot in both orientations. -->
                                                <Border DockPanel.Dock="Top" Padding="6,3"
                                                        Background="White"
                                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                                                    <ItemsControl ItemsSource="{Binding LegendItems}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ChartParameterRef}">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                                    <ToggleButton x:Name="LegendButton"
                                                                                  Padding="4,2"
                                                                                  Background="Transparent"
                                                                                  BorderThickness="0"
                                                                                  Cursor="Hand"
                                                                                  ToolTip="Нажмите, чтобы настроить вид кривой">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <!-- Line sample: colour + dash pattern + thickness -->
                                                                            <Line X1="0" Y1="6" X2="26" Y2="6"
                                                                                  VerticalAlignment="Center" Margin="0,0,5,0"
                                                                                  Stroke="{Binding Color.Brush}"
                                                                                  StrokeThickness="{Binding LineWidth}"
                                                                                  StrokeDashArray="{Binding DashArray}"/>
                                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </ToggleButton>

                                                                    <Popup IsOpen="{Binding IsChecked, ElementName=LegendButton, Mode=TwoWay}"
                                                                           PlacementTarget="{Binding ElementName=LegendButton}"
                                                                           Placement="Bottom"
                                                                           StaysOpen="False"
                                                                           AllowsTransparency="True">
                                                                        <Border Background="White"
                                                                                BorderBrush="{StaticResource PanelBorder}"
                                                                                BorderThickness="1" Padding="8">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontWeight="SemiBold" Margin="0,0,0,6"/>

                                                                                <TextBlock Text="Цвет" Margin="0,0,0,3"
                                                                                           Foreground="{StaticResource MutedForeground}"/>
                                                                                <ListBox ItemsSource="{Binding Source={x:Static vm:ChartParameterRef.ColorOptions}}"
                                                                                         SelectedItem="{Binding Color, Mode=TwoWay}"
                                                                                         Width="288" MaxHeight="180"
                                                                                         BorderThickness="1"
                                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                                    <ListBox.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <UniformGrid Columns="12"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ListBox.ItemsPanel>
                                                                                    <ListBox.ItemContainerStyle>
                                                                                        <Style TargetType="ListBoxItem">
                                                                                            <Setter Property="Padding" Value="1"/>
                                                                                            <Setter Property="Margin" Value="0"/>
                                                                                        </Style>
                                                                                    </ListBox.ItemContainerStyle>
                                                                                    <ListBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Width="20" Height="14" Background="{Binding Brush}"/>
                                                                                        </DataTemplate>
                                                                                    </ListBox.ItemTemplate>
                                                                                </ListBox>

                                                                                <TextBlock Text="Тип линии" Margin="0,8,0,3"
                                                                                           Foreground="{StaticResource MutedForeground}"/>
                                                                                <ComboBox Width="288"
                                                                                          ItemsSource="{Binding Source={x:Static vm:ChartParameterRef.LineTypeOptions}}"
                                                                                          DisplayMemberPath="Label"
                                                                                          SelectedValuePath="Value"
                                                                                          SelectedValue="{Binding LineType, Mode=TwoWay}"/>

                                                                                <TextBlock Text="Толщина линии" Margin="0,8,0,3"
                                                                                           Foreground="{StaticResource MutedForeground}"/>
                                                                                <ComboBox Width="288"
                                                                                          ItemsSource="{Binding Source={x:Static vm:ChartParameterRef.LineWidthOptions}}"
                                                                                          SelectedItem="{Binding LineWidth, Mode=TwoWay}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Popup>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <!-- Chart -->
                                                <sp:WpfPlot Loaded="ChartPlot_Loaded"
                                                            Unloaded="ChartPlot_Unloaded"
                                                            ToolTip="Двойной клик по точке — значение; Shift + протяните мышью — среднее / мин / макс по участку"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ===== Таблица ===== -->
                <TabItem Header="Таблица">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="180"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ============== Left: "Показывать колонки" panel ============== -->
                        <DockPanel Grid.Column="0" Background="White">
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                <TextBlock Text="Показывать колонки" Style="{StaticResource SectionHeaderText}"/>
                            </Border>

                            <!-- Bottom: Up/Down/All controls -->
                            <Border DockPanel.Dock="Bottom" Padding="6"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0"
                                    Background="{StaticResource PanelBackground}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Вверх" Command="{Binding MoveColumnUpCommand}"   Width="60" Margin="0,0,4,0"
                                            ToolTip="Переместить выбранную колонку вверх"/>
                                    <Button Content="Вниз"  Command="{Binding MoveColumnDownCommand}" Width="60" Margin="0,0,8,0"
                                            ToolTip="Переместить выбранную колонку вниз"/>
                                    <CheckBox Content="Все"
                                              IsChecked="{Binding AllColumnsVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="Показать или скрыть сразу все колонки"/>
                                </StackPanel>
                            </Border>

                            <!-- The checkbox list -->
                            <ListBox ItemsSource="{Binding Columns}"
                                     SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:ColumnVisibility}">
                                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  Content="{Binding DisplayName}"
                                                  ToolTip="{Binding Description}"
                                                  VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

                        <DataGrid Grid.Column="2"
                                  x:Name="DataGrid"
                                  ItemsSource="{Binding CurrentTableData}"
                                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                  SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F7F9FB"/>
                    </Grid>
                </TabItem>

                <!-- ===== Операции ===== -->
                <TabItem Header="Операции">
                    <DataGrid x:Name="OperationsGrid"
                              ItemsSource="{Binding OperationsData}"
                              AutoGeneratingColumn="OperationsGrid_AutoGeneratingColumn"
                              IsReadOnly="True"
                              AutoGenerateColumns="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F9FB"/>
                </TabItem>
        </TabControl>

    </DockPanel>
</Window>
