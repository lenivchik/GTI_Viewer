<Window x:Class="FirebirdViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FirebirdViewer.ViewModels"
        xmlns:m="clr-namespace:FirebirdViewer.Models"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="780" Width="1300"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5"                      Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F5" Modifiers="Control"  Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- ===================== Top menu ===================== -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Подключиться к базе..."  Click="ConnectMenu_Click"/>
                <MenuItem Header="_Отключиться"             Command="{Binding DisconnectCommand}"/>
                <Separator/>
                <MenuItem Header="_Недавние подключения" ItemsSource="{Binding RecentConnections}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Display}"/>
                            <Setter Property="Command" Value="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Очистить список"  Command="{Binding ClearRecentCommand}"/>
                <Separator/>
                <MenuItem Header="_Сохранить таблицу в CSV..."     Command="{Binding ExportDataCommand}"/>
                <MenuItem Header="Сохранить _операции в CSV..."    Command="{Binding ExportOperationsCommand}"/>
                <Separator/>
                <MenuItem Header="В_ыход" Click="ExitMenu_Click"/>
            </MenuItem>

            <MenuItem Header="_Правка">
                <MenuItem Header="_Копировать выделенное" Command="ApplicationCommands.Copy"/>
            </MenuItem>

            <MenuItem Header="_Показать">
                <MenuItem Header="Показать _все колонки"       Command="{Binding ToggleAllColumnsCommand}"/>
                <Separator/>
                <MenuItem Header="Переместить колонку в_верх"  Command="{Binding MoveColumnUpCommand}"/>
                <MenuItem Header="Переместить колонку в_низ"   Command="{Binding MoveColumnDownCommand}"/>
                <Separator/>
                <MenuItem Header="_Обновить данные"  Command="{Binding RefreshCommand}" InputGestureText="F5"/>
            </MenuItem>

            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===================== Status bar (bottom) ===================== -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource StatusBackground}">
            <StatusBarItem>
                <Border Background="#3CB371" Padding="8,2" CornerRadius="2"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding RowCountText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding OperationsCountText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding CursorText}" Foreground="{StaticResource MutedForeground}"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ConnectionInfoText}" Foreground="{StaticResource MutedForeground}" Margin="0,0,8,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===================== Top bar: well + race pickers ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6">
            <DockPanel>
                <!-- Right: row limit + refresh -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Показывать записей:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding RowLimit, UpdateSourceTrigger=LostFocus}" Width="70"
                             ToolTip="Максимальное число строк, загружаемых из базы"/>
                    <Button Content="Обновить" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                            ToolTip="Перечитать данные текущей скважины и рейса (F5)"/>
                </StackPanel>
                <!-- Left: well + race pickers -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Скважина:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="280"
                              ItemsSource="{Binding Wells}"
                              SelectedItem="{Binding SelectedWell, Mode=TwoWay}"
                              IsEnabled="{Binding IsConnected}"
                              ToolTip="Выберите скважину для просмотра">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Рейс:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox Width="260"
                              ItemsSource="{Binding Races}"
                              SelectedItem="{Binding SelectedRace, Mode=TwoWay}"
                              IsEnabled="{Binding IsConnected}"
                              ToolTip="Ограничьте просмотр одним рейсом или выберите «Все рейсы»">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Main: tab control ===================== -->
        <TabControl Margin="6" SelectedIndex="1">

                <!-- ===== Графики ===== -->
                <TabItem Header="Графики">
                    <DockPanel>
                        <!-- Toolbar: + Добавить график -->
                        <Border DockPanel.Dock="Top" Padding="6"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Добавить график"
                                        Command="{Binding AddChartCommand}"
                                        Padding="10,3"
                                        ToolTip="Создать ещё одну панель графика"/>
                            </StackPanel>
                        </Border>

                        <!-- One row per ChartPanelViewModel, stacked vertically -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Charts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartPanelViewModel}">
                                        <Border BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="0,0,0,1"
                                                Margin="0,0,0,4"
                                                Background="White"
                                                MinHeight="360">
                                            <DockPanel>
                                                <!-- Per-chart header: title, axis, orientation, remove -->
                                                <Border DockPanel.Dock="Top" Padding="6"
                                                        Background="{StaticResource PanelBackground}"
                                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕"
                                                                Width="24" Height="22"
                                                                ToolTip="Удалить этот график"
                                                                Command="{Binding DataContext.RemoveChartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="160" VerticalAlignment="Center"
                                                                     ToolTip="Название графика"/>

                                                            <TextBlock Text="Ось X:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                                            <RadioButton Content="Время" Margin="0,0,8,0"
                                                                         IsChecked="{Binding XAxisIsTime, Mode=TwoWay}"/>
                                                            <RadioButton Content="Глубина забоя"
                                                                         IsChecked="{Binding XAxisIsDepth, Mode=TwoWay}"/>

                                                            <TextBlock Text="Ориентация:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                                            <RadioButton Content="Горизонт." Margin="0,0,8,0"
                                                                         IsChecked="{Binding OrientationIsHorizontal, Mode=TwoWay}"/>
                                                            <RadioButton Content="Вертикальн."
                                                                         IsChecked="{Binding OrientationIsVertical, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Per-chart parameter checkbox list -->
                                                <Border DockPanel.Dock="Left" Width="200"
                                                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                                                    <ListBox ItemsSource="{Binding Parameters}"
                                                             BorderThickness="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="2"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ChartParameterRef}">
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Content="{Binding DisplayName}"
                                                                          ToolTip="{Binding Description}"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>

                                                <!-- Chart -->
                                                <oxy:PlotView Model="{Binding ChartModel}" Background="White"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ===== Таблица ===== -->
                <TabItem Header="Таблица">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="180"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ============== Left: "Показывать колонки" panel ============== -->
                        <DockPanel Grid.Column="0" Background="White">
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                <TextBlock Text="Показывать колонки" Style="{StaticResource SectionHeaderText}"/>
                            </Border>

                            <!-- Bottom: Up/Down/All controls -->
                            <Border DockPanel.Dock="Bottom" Padding="6"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0"
                                    Background="{StaticResource PanelBackground}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Вверх" Command="{Binding MoveColumnUpCommand}"   Width="60" Margin="0,0,4,0"
                                            ToolTip="Переместить выбранную колонку вверх"/>
                                    <Button Content="Вниз"  Command="{Binding MoveColumnDownCommand}" Width="60" Margin="0,0,8,0"
                                            ToolTip="Переместить выбранную колонку вниз"/>
                                    <CheckBox Content="Все"
                                              IsChecked="{Binding AllColumnsVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="Показать или скрыть сразу все колонки"/>
                                </StackPanel>
                            </Border>

                            <!-- The checkbox list -->
                            <ListBox ItemsSource="{Binding Columns}"
                                     SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:ColumnVisibility}">
                                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  Content="{Binding DisplayName}"
                                                  ToolTip="{Binding Description}"
                                                  VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

                        <DataGrid Grid.Column="2"
                                  x:Name="DataGrid"
                                  ItemsSource="{Binding CurrentTableData}"
                                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                  SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F7F9FB"/>
                    </Grid>
                </TabItem>

                <!-- ===== Операции ===== -->
                <TabItem Header="Операции">
                    <DataGrid x:Name="OperationsGrid"
                              ItemsSource="{Binding OperationsData}"
                              AutoGeneratingColumn="OperationsGrid_AutoGeneratingColumn"
                              IsReadOnly="True"
                              AutoGenerateColumns="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F9FB"/>
                </TabItem>
        </TabControl>

    </DockPanel>
</Window>
