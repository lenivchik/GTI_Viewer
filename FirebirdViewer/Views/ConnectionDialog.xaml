<Window x:Class="FirebirdViewer.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FirebirdViewer.Localization"
        Title="{l:Tr Conn_Title}"
        Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Conn_Server}" Margin="0,8,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4"
                   Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr Conn_Port}" Margin="0,8,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                   Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Tr Conn_Database}" Margin="0,8,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4"
                   Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{l:Tr Conn_Database_Tip}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:Tr Conn_User}" Margin="0,8,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,4" Width="200" HorizontalAlignment="Left"
                   Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:Tr Conn_Password}" Margin="0,8,12,8" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                     Width="200" HorizontalAlignment="Left"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{l:Tr Conn_Charset}" Margin="0,8,12,8" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="5" Grid.Column="1" Margin="0,4" Width="140" HorizontalAlignment="Left"
                   IsEditable="True"
                   Text="{Binding Charset, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="UTF8"/>
            <ComboBoxItem Content="WIN1251"/>
            <ComboBoxItem Content="ISO8859_1"/>
            <ComboBoxItem Content="NONE"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Tr Conn_Connect}" Click="OK_Click" IsDefault="True"
                    MinWidth="120" Padding="10,2" Margin="0,0,8,0"/>
            <Button Content="{l:Tr Conn_Cancel}" Click="Cancel_Click" IsCancel="True" MinWidth="100" Padding="10,2"/>
        </StackPanel>
    </Grid>
</Window>
